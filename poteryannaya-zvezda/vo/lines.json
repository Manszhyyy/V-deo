[
 {"id": "v1", "text": "Однажды ночью с неба упала звезда."},
 {"id": "v2", "text": "Маленькая. Испуганная. Совсем одна."},
 {"id": "v3", "text": "Чтобы вернуть её домой, нужно подняться выше всех."},
 {"id": "v4", "text": "Даже если на пути гроза."},
 {"id": "v5", "text": "Иногда даже звёздам нужен друг."}
